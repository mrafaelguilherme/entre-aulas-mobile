# Modelo das variaveis de ambiente.
# Nao edite este arquivo com segredos reais.
# Para criar o seu .env, rode: node scripts/setup-env.mjs

# Segredos: o script troca __GERAR__ por valores aleatorios.
JWT_SECRET=__GERAR__
MONGO_PASSWORD=__GERAR__

# Banco de dados
MONGO_USER=entreaulas

# Conta master criada pela API na primeira subida (somente demonstracao).
MASTER_EMAIL=master@entreaulas.com.br
MASTER_PASSWORD=master-entre-aulas-2026

# Senha das contas de demonstracao criadas pelo seed (somente demonstracao).
SEED_PASSWORD=demo-entre-aulas-2026

# Liga a documentacao da API em /api (Swagger).
ENABLE_API_DOCS=true